<div class="container mx-auto px-4 py-8">
  <h1 class="text-2xl font-bold mb-6">每月交易摘要</h1>

  <%= render 'date_filter' %>

  <div class="bg-white rounded-lg shadow overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">月份</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">交易次數</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">損益</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @summaries.each do |summary| %>
          <tr>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
              <%= summary.month_start.strftime("%Y-%m") %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
              <%= summary.total_trades %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm <%= summary.total_profit_loss >= 0 ? 'text-green-600' : 'text-red-600' %>">
              <%= number_to_currency(summary.total_profit_loss) %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="mt-4">
    <%== pagy_nav(@pagy) %>
  </div>
</div>
