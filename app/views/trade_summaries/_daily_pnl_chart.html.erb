<!-- Daily P&L Chart -->
<%# Get all dates in the selected month %>
<% start_date = @selected_date.beginning_of_month %>
<% end_date = @selected_date.end_of_month %>
<% all_dates = (start_date..end_date).to_a %>

<%# Group trades by date and calculate daily net PNL %>
<% daily_pnl = @trade_logs.group_by(&:trade_date).transform_values { |logs| logs.sum { |log| log.net_pnl.to_f } } %>

<%# Create a hash with all dates in the month, defaulting to 0 for dates with no trades %>
<% monthly_data = all_dates.each_with_object({}) do |date, hash|
  hash[date.strftime('%m-%d')] = daily_pnl[date] || 0
end %>

<%# Split data into positive and negative, ensuring all dates are present in both datasets %>
<% positive_data = monthly_data.transform_values { |v| v > 0 ? v : 0 } %>
<% negative_data = monthly_data.transform_values { |v| v < 0 ? v : 0 } %>

<div class="card card-chart p-6">
  <h2 class="text-lg font-semibold mb-4">每日損益</h2>
  <%= column_chart [
    {
      name: "獲利",
      data: positive_data,
      color: "#DC2626"
    },
    {
      name: "虧損",
      data: negative_data,
      color: "#16A34A"
    }
  ],
      xtitle: "日期",
      ytitle: "損益",
      library: {
        scales: {
          x: {
            title: { display: true, text: "日期" }
          },
          y: {
            title: { display: true, text: "損益" },
            beginAtZero: true
          }
        },
        plugins: {
          tooltip: {
            backgroundColor: '#1E293B',
            titleColor: '#E2E8F0',
            bodyColor: '#F1F5F9',
            borderColor: '#334155',
            borderWidth: 1,
            cornerRadius: 8,
            padding: 12,
            titleFont: { family: 'JetBrains Mono', size: 11 },
            bodyFont: { family: 'JetBrains Mono', size: 13, weight: 'bold' }
          }
        }
      },
      stacked: true
      %>
</div>
