<div class="container mx-auto px-2 md:px-4 py-6 md:py-8">
  <div class="flex flex-col md:flex-row md:justify-between md:items-center gap-3 mb-6 animate-in page-header">
    <div class="flex items-center gap-3">
      <h1>每日交易紀錄</h1>
      <%= link_to "新增交易記錄",
          new_trade_log_path,
          class: "btn btn-sm md:btn #{@trade_logs.present? || @selected_date > Date.today ? 'btn-ghost' : 'btn-success'}",
          disabled: @trade_logs.present? || @selected_date > Date.today %>
    </div>
    <%= form_tag daily_trade_summaries_path, method: :get, class: "flex items-center", data: { controller: "date-nav" } do %>
      <div class="flex items-center gap-2 date-nav-controls">
        <%= link_to "前一天", daily_trade_summaries_path(date: @selected_date - 1.day), class: "btn btn-ghost btn-sm" %>
        <%= date_field_tag :date, @selected_date, class: "rounded border-gray-300 text-sm w-36", data: { action: "change->date-nav#change" } %>
        <span class="text-gray-700 font-bold text-sm"><%= t('date.day_names')[@selected_date.wday] %></span>
        <%= link_to "後一天", daily_trade_summaries_path(date: @selected_date + 1.day), class: "btn btn-ghost btn-sm" %>
      </div>
    <% end %>
  </div>

  <%= render "trade_type_filter" %>

  <% has_trades = @trade_logs.present? %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6 mt-4 md:mt-6">
    <!-- Capital & Risk Management -->
    <div class="animate-in animate-in-1">
      <%= render 'capital_risk_management' %>
    </div>
    <!-- Daily Risk Highlights -->
    <div class="card card-risk p-6 animate-in animate-in-2">
      <h2 class="text-lg font-semibold mb-4">風險指標</h2>

      <div class="space-y-3 md:space-y-4">
        <div class="flex justify-between items-center gap-2">
          <% max_daily_trades = 8 %>
          <span class="text-gray-700 text-sm">交易次數: (< <%= max_daily_trades %>)</span>
          <span class="font-medium text-sm whitespace-nowrap <%= @statistics[:trade_count] >= max_daily_trades ? 'risk-danger' : '' %>">
            <%= @statistics[:trade_count] %>
            <% if @statistics[:trade_count] >= max_daily_trades %>
              (>= <%= max_daily_trades %>)
            <% end %>
          </span>
        </div>
        <div class="flex justify-between items-center gap-2">
          <% max_consecutive_losses = 3 %>
          <span class="text-gray-700 text-sm">最大連續虧損次數: (< <%= max_consecutive_losses %>)</span>
          <span class="font-medium text-sm whitespace-nowrap <%= @statistics[:max_consecutive_losses] >= max_consecutive_losses ? 'risk-danger' : '' %>">
            <%= @statistics[:max_consecutive_losses] %>
            <% if @statistics[:max_consecutive_losses] >= max_consecutive_losses %>
              (>= <%= max_consecutive_losses %>)
            <% end %>
          </span>
        </div>
        <div class="flex justify-between items-center gap-2">
          <% max_loss = @statistics[:max_loss] %>
          <% risk_amount = @month_report.ending_capital * current_user.risk_amount_percentage_per_trade / 100 %>
          <span class="text-gray-700 text-sm">當日單筆最大虧損: (< <%= number_with_precision(risk_amount, precision: 0) %>)</span>
          <% risk_percentage = @month_report.ending_capital.zero? ? 0 : (max_loss.abs.to_f / risk_amount * 100).round %>
          <span class="font-medium text-sm whitespace-nowrap <%=
            if risk_percentage >= 100
              'risk-danger'
            elsif risk_percentage >= 61.8
              'risk-caution'
            else
              ''
            end
          %>">
            <%= number_with_precision(max_loss, precision: 0) %>
            <% if risk_amount > 0 %>
              (<%= risk_percentage %>%)
            <% end %>
          </span>
        </div>

        <div class="flex justify-between items-center gap-2">
          <% total_net_pnl = @statistics[:total_net_profit] %>
          <% risk_amount = @month_report.ending_capital * current_user.risk_amount_percentage_per_day / 100 %>
          <span class="text-gray-700 text-sm">當日淨損益: (< <%= number_with_precision(risk_amount, precision: 0) %>)</span>
          <% quota = @month_report.ending_capital.zero? ? 0 : (total_net_pnl < 0 ? risk_amount + total_net_pnl : risk_amount) %>
          <span class="font-medium text-sm whitespace-nowrap <%=
            if total_net_pnl < 0 && quota <= 0
              'risk-danger'
            elsif total_net_pnl < 0 && quota <= risk_amount * 0.382
              'risk-caution'
            elsif total_net_pnl >= 0
              'text-profit'
            else
              ''
            end
          %>">
            <%= number_with_precision(total_net_pnl, precision: 0) %>
            <% if total_net_pnl < 0 && risk_amount > 0 %>
              (剩餘: <%= number_with_precision(quota, precision: 0) %>)
            <% end %>
          </span>
        </div>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6 mt-4 md:mt-6 animate-in animate-in-3">
    <!-- Trading Performance -->
    <%= render 'trading_performance', statistics: @statistics, title: '(總計)' %>
  </div>

  <% if has_trades %>
    <div class="card card-data overflow-hidden mt-4 md:mt-6 animate-in animate-in-4">
      <div class="summary-bar">
        <div class="px-3 md:px-6 py-3 md:py-4 flex flex-wrap justify-end gap-3 md:gap-8">
          <div class="text-xs md:text-sm text-gray-900">
            損益：<%= number_with_precision(@trade_logs.sum { |log| log.gross_pnl || 0 }, precision: 0) %>
          </div>
          <div class="text-xs md:text-sm text-gray-900">
            手續費：<%= number_with_precision(@trade_logs.sum { |log| log.commission || 0 }, precision: 0) %>
          </div>
          <div class="text-xs md:text-sm text-gray-900">
            交易稅：<%= number_with_precision(@trade_logs.sum { |log| log.tax || 0 }, precision: 0) %>
          </div>
          <% total_net = @trade_logs.sum { |log| log.net_pnl || 0 } %>
          <div class="text-xs md:text-sm font-semibold <%= total_net >= 0 ? 'text-profit' : 'text-loss' %>">
            淨損益：<%= number_with_precision(total_net, precision: 0) %>
          </div>
        </div>
      </div>
      <div class="overflow-x-auto">
        <%= render 'trade_logs_table', active_logs: @trade_logs %>
      </div>
    </div>
  <% else %>
    <!-- Empty State -->
    <div class="empty-state mt-6 animate-in animate-in-4">
      <div class="empty-state-icon">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
      </div>
      <div class="empty-state-title"><%= @selected_date.strftime('%Y/%m/%d') %> No Trades</div>
      <div class="empty-state-text">This day has no trading records. Import a broker CSV or navigate to a date with trades.</div>
      <%= link_to "Import Trades", new_trade_log_path, class: "btn btn-primary" %>
    </div>
  <% end %>
</div>
