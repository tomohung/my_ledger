<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <div class="flex items-center gap-4">
      <h1 class="text-2xl font-bold">每日交易紀錄</h1>
      <%= link_to "返回交易紀錄列表", trade_logs_path, class: "text-blue-600 hover:text-blue-800" %>
    </div>
    <%= form_tag daily_trade_summaries_path, method: :get, class: "flex items-center gap-4" do %>
      <div class="flex items-center gap-2">
        <%= link_to "前一天", daily_trade_summaries_path(date: @selected_date - 1.day), class: "px-4 py-2 bg-gray-500 text-white rounded hover:bg-gray-600" %>
        <%= label_tag :date, "選擇日期" %>
        <%= date_field_tag :date, @selected_date, class: "rounded border-gray-300" %>
        <span class="text-gray-700 font-bold"><%= t('date.day_names')[@selected_date.wday] %></span>
        <%= link_to "後一天", daily_trade_summaries_path(date: @selected_date + 1.day), class: "px-4 py-2 bg-gray-500 text-white rounded hover:bg-gray-600" %>
      </div>
      <%= submit_tag "查詢", class: "px-4 py-2 bg-blue-500 text-white rounded hover:bg-blue-600" %>
    <% end %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6">
    <!-- Capital & Risk Management -->
    <%= render 'capital_risk_management' %>
    <!-- Daily Risk Highlights -->
    <div class="bg-white rounded-lg shadow p-6">
      <h2 class="text-lg font-semibold mb-4">風險指標</h2>
      <div class="space-y-4">
        <!-- Add spacing with CSS margin instead of empty divs -->
        <div class="mt-24"></div>
        <div class="flex justify-between items-center">
          <span class="text-gray-700">當日最大虧損:</span>
          <% max_loss = @trade_logs.map { |log| log.net_pnl || 0 }.min || 0 %>
          <% risk_percentage = @month_report.ending_capital.zero? ? 0 : (max_loss.abs.to_f / (@month_report.ending_capital * current_user.risk_amount_percentage_per_trade / 100) * 100).round %>
          <span class="font-medium <%=
            if risk_percentage >= 100
              'text-red-600 font-bold'
            elsif risk_percentage >= 75
              'text-yellow-600 font-bold'
            else
              'text-gray-900'
            end
          %>">
            <%= number_with_precision(max_loss, precision: 0) %>
            <% if @month_report.ending_capital > 0 %>
              (<%= risk_percentage %>% of risk)
            <% end %>
          </span>
        </div>

        <div class="flex justify-between items-center">
          <span class="text-gray-700">當日淨損益:</span>
          <% total_net_pnl = @trade_logs.sum { |log| log.net_pnl || 0 } %>
          <% risk_percentage = @month_report.ending_capital.zero? ? 0 : (total_net_pnl.abs.to_f / (@month_report.ending_capital * current_user.risk_amount_percentage_per_day / 100) * 100).round %>
          <span class="font-medium <%=
            if total_net_pnl < 0 && risk_percentage >= 100
              'text-red-600 font-bold'
            elsif total_net_pnl < 0 && risk_percentage >= 75
              'text-yellow-600 font-bold'
            elsif total_net_pnl >= 0
              'text-green-600'
            else
              'text-gray-900'
            end
          %>">
            <%= number_with_precision(total_net_pnl, precision: 0) %>
            <% if total_net_pnl < 0 && @month_report.ending_capital > 0 %>
              (<%= risk_percentage %>% of risk)
            <% end %>
          </span>
        </div>
      </div>
    </div>

  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6">
    <!-- Trading Performance -->
    <%= render 'trading_performance' %>
  </div>

  <div class="bg-white rounded-lg shadow overflow-hidden mt-6">
    <div class="bg-gray-50 border-b border-gray-200">
      <div class="px-6 py-4 flex justify-end">
        <div class="flex items-center gap-8">
          <div class="text-sm text-gray-900">
            損益：<%= number_with_precision(@trade_logs.sum { |log| log.gross_pnl || 0 }, precision: 0) %>
          </div>
          <div class="text-sm text-gray-900">
            手續費：<%= number_with_precision(@trade_logs.sum { |log| log.commission || 0 }, precision: 0) %>
          </div>
          <div class="text-sm text-gray-900">
            交易稅：<%= number_with_precision(@trade_logs.sum { |log| log.tax || 0 }, precision: 0) %>
          </div>
          <div class="text-sm <%= @trade_logs.sum { |log| log.net_pnl || 0 } >= 0 ? 'text-green-600' : 'text-red-600' %>">
            淨損益：<%= number_with_precision(@trade_logs.sum { |log| log.net_pnl || 0 }, precision: 0) %>
          </div>
        </div>
      </div>
    </div>
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">券商帳戶</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">商品名稱</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">合約月份</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">買口數</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">賣口數</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">成交價格</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">損益</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">手續費</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">交易稅</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">淨損益</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">幣別</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">委託書號</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @trade_logs.each do |trade_log| %>
          <tr>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
              <%= trade_log.broker_account.name %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
              <%= trade_log.product_name %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
              <%= trade_log.contract_month %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
              <%= trade_log.buy_quantity %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
              <%= trade_log.sell_quantity %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
              <%= number_with_precision(trade_log.price) %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
              <%= trade_log.gross_pnl ? number_with_precision(trade_log.gross_pnl, precision: 0) : '' %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
              <%= trade_log.commission ? number_with_precision(trade_log.commission, precision: 0) : '' %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
              <%= trade_log.tax ? number_with_precision(trade_log.tax, precision: 0) : '' %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm <%= trade_log.net_pnl.to_f >= 0 ? 'text-green-600' : 'text-red-600' %>">
              <%= trade_log.net_pnl ? number_with_precision(trade_log.net_pnl, precision: 0) : '' %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
              <%= trade_log.currency %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
              <%= trade_log.order_id %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
