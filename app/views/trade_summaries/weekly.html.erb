<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <div class="flex items-center gap-4">
      <h1 class="text-2xl font-bold">每週交易摘要</h1>
    </div>
    <%= form_tag weekly_trade_summaries_path, method: :get, class: "flex items-center gap-4" do %>
      <div class="flex items-center gap-2">
        <%= link_to "前一週", weekly_trade_summaries_path(date: @selected_date - 1.week), class: "btn btn-ghost" %>
        <%= label_tag :date, "選擇日期" %>
        <%= date_field_tag :date, @selected_date, class: "rounded border-gray-300" %>
        <%= link_to "後一週", weekly_trade_summaries_path(date: @selected_date + 1.week), class: "btn btn-ghost" %>
      </div>
      <%= submit_tag "查詢", class: "btn btn-ghost" %>
    <% end %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <%= render 'calendar' %>

    <!-- Weekly PnL Summary -->
    <div class="bg-white rounded-lg shadow p-6">
      <h2 class="text-lg font-semibold mb-4">本週每日淨損益</h2>
      <%= render 'weekly_pnl_summary_chart' %>
    </div>

    <!-- Gross PnL Chart -->
    <div class="bg-white rounded-lg shadow p-6">
      <h2 class="text-lg font-semibold mb-4">本週交易損益走勢</h2>
      <%= render 'weekly_pnl_chart' %>
    </div>

  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6">
    <!-- Capital & Risk Management -->
    <%= render 'capital_risk_management' %>

    <!-- Weekly Risk Information -->
    <%= render 'weekly_risk_info' %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6">
    <!-- Trading Performance -->
    <%= render 'trading_performance', statistics: @statistics, title: '(總計)' %>
  </div>

  <div class="bg-white rounded-lg shadow overflow-hidden mt-6">
    <%= render 'trade_logs_table', active_logs: @trade_logs.select { |log| log.net_pnl.present? }.sort_by(&:net_pnl) %>
  </div>
</div>
