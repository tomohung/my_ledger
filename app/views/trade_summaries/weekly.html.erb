<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <div class="flex items-center gap-4">
      <h1 class="text-2xl font-bold">每週交易摘要</h1>
    </div>
    <%= form_tag weekly_trade_summaries_path, method: :get, class: "flex items-center gap-4" do %>
      <div class="flex items-center gap-2">
        <%= link_to "前一週", weekly_trade_summaries_path(date: @selected_date - 1.week), class: "px-4 py-2 bg-gray-500 text-white rounded hover:bg-gray-600" %>
        <%= label_tag :date, "選擇日期" %>
        <%= date_field_tag :date, @selected_date, class: "rounded border-gray-300" %>
        <%= link_to "後一週", weekly_trade_summaries_path(date: @selected_date + 1.week), class: "px-4 py-2 bg-gray-500 text-white rounded hover:bg-gray-600" %>
      </div>
      <%= submit_tag "查詢", class: "px-4 py-2 bg-blue-500 text-white rounded hover:bg-blue-600" %>
    <% end %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <%= render 'calendar' %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6">
    <!-- Capital & Risk Management -->
    <%= render 'capital_risk_management' %>

    <!-- Weekly Risk Information -->
    <div class="bg-white rounded-lg shadow p-6">
      <h2 class="text-lg font-semibold mb-4">本週風險管理</h2>
      <div class="space-y-4">
        <div class="flex justify-between items-center">
          <% max_consecutive_losses = 6 %>
          <span class="text-gray-700">最大連續虧損次數: (< <%= max_consecutive_losses %>)</span>
          <span class="font-medium <%= @statistics[:max_consecutive_losses] >= max_consecutive_losses ? 'text-red-600 font-bold' : 'text-gray-900' %>">
            <%= @statistics[:max_consecutive_losses] %>
            <% if @statistics[:max_consecutive_losses] >= max_consecutive_losses %>
              (>= <%= max_consecutive_losses %>)
            <% end %>
          </span>
        </div>
        <div class="flex justify-between items-center">
          <% max_win_rate = 40 %>
          <span class="text-gray-700">勝率: (< <%= max_win_rate %> %)</span>
          <span class="font-medium <%= @statistics[:win_rate] <= max_win_rate ? 'text-red-600 font-bold' : 'text-gray-900' %>">
            <%= number_to_percentage(@statistics[:win_rate], precision: 1) %>
            <% if @statistics[:win_rate] <= max_win_rate %>
              (<= <%= max_win_rate %>%)
            <% end %>
          </span>
        </div>
        <div class="flex justify-between items-center">
          <% max_loss = @statistics[:max_loss] %>
          <% risk_amount = @month_report.ending_capital * current_user.risk_amount_percentage_per_trade / 100 %>
          <% risk_percentage = @month_report.ending_capital.zero? ? 0 : (max_loss.abs.to_f / risk_amount * 100).round %>
          <span class="text-gray-700">當週單筆最大虧損: (< <%= number_with_precision(risk_amount, precision: 0) %>)</span>
          <span class="font-medium <%=
            if risk_percentage >= 100
              'text-red-600 font-bold'
            elsif risk_percentage >= 75
              'text-yellow-600 font-bold'
            else
              'text-gray-900'
            end
          %>">
            <%= number_with_precision(max_loss, precision: 0) %>
            <% if @month_report.ending_capital > 0 %>
              (<%= risk_percentage %>% of risk)
            <% end %>
          </span>
        </div>
        <div class="flex justify-between">
          <% total_net_pnl = @trade_logs.sum { |log| log.net_pnl.to_f } %>
          <% risk_amount = @month_report.ending_capital * current_user.risk_amount_percentage_per_week / 100 %>
          <% risk_percentage = @month_report.ending_capital.zero? ? 0 : (total_net_pnl.abs.to_f / risk_amount * 100).round %>
          <span class="text-gray-700">本週淨損益: (< <%= number_with_precision(risk_amount, precision: 0) %>)</span>
          <span class="font-medium <%=
            if total_net_pnl > 0
              'text-green-600'
            elsif risk_percentage >= 100
              'text-red-600 font-bold'
            elsif risk_percentage >= 75
              'text-yellow-600 font-bold'
            else
              'text-gray-900'
            end
          %>">
            <%= number_with_precision(total_net_pnl, precision: 0) %>
            <% if total_net_pnl < 0 && @month_report.ending_capital > 0 %>
              (<%= risk_percentage %>% of risk)
            <% end %>
          </span>
        </div>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6">
    <!-- Trading Performance -->
    <%= render 'trading_performance' %>
  </div>

  <div class="bg-white rounded-lg shadow overflow-hidden mt-6">
    <%= render 'trade_logs_table', active_logs: @trade_logs.select { |log| log.net_pnl.to_f.abs > 0.5 * @month_report.ending_capital * current_user.risk_amount_percentage_per_trade / 100 }.sort_by(&:net_pnl) %>
  </div>
</div>
