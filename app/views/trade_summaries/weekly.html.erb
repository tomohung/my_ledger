<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <div class="flex items-center gap-4">
      <h1 class="text-2xl font-bold">每週交易摘要</h1>
      <%= link_to "返回交易紀錄列表", trade_logs_path, class: "text-blue-600 hover:text-blue-800" %>
    </div>
    <%= form_tag weekly_trade_summaries_path, method: :get, class: "flex items-center gap-4" do %>
      <div class="flex items-center gap-2">
        <%= link_to "前一週", weekly_trade_summaries_path(date: @selected_date - 1.week), class: "px-4 py-2 bg-gray-500 text-white rounded hover:bg-gray-600" %>
        <%= label_tag :date, "選擇日期" %>
        <%= date_field_tag :date, @selected_date, class: "rounded border-gray-300" %>
        <%= link_to "後一週", weekly_trade_summaries_path(date: @selected_date + 1.week), class: "px-4 py-2 bg-gray-500 text-white rounded hover:bg-gray-600" %>
      </div>
      <%= submit_tag "查詢", class: "px-4 py-2 bg-blue-500 text-white rounded hover:bg-blue-600" %>
    <% end %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
    <%= render 'trading_performance' %>
  </div>

  <div class="bg-white rounded-lg shadow p-6">
    <h2 class="text-lg font-semibold mb-4">本週交易區間</h2>
    <p class="text-gray-600">
      <%= @selected_date.beginning_of_week.strftime("%Y-%m-%d") %> 至
      <%= @selected_date.end_of_week.strftime("%Y-%m-%d") %>
    </p>
  </div>
</div>
