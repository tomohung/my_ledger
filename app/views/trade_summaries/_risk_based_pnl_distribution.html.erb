<%# Calculate risk amount per trade %>
<% risk_amount = @month_report.initial_capital * current_user.risk_amount_percentage_per_trade / 100 %>
<% interval = 0.5 %>
<% interval_amount = risk_amount * interval %>

<%# Group trades by date and calculate daily net PNL %>
<% daily_pnl = @trade_logs.group_by(&:trade_date).transform_values { |logs| logs.sum { |log| log.net_pnl.to_f } } %>

<%# Categorize daily PNL into risk-based intervals %>
<% distribution = Hash.new(0) %>
<% daily_pnl.each do |date, pnl| %>
  <% risk_ratio = (pnl / interval_amount).round(0) %>
  <% distribution[risk_ratio] += 1 %>
<% end %>

<%# Sort the distribution by risk ratio %>
<% keys = distribution.keys %>
<% min_key = keys.min || 0 %>
<% max_key = keys.max || 0 %>
<% sorted_distribution = {} %>
<% (min_key..max_key).each do |key| %>
  <% sorted_distribution[key * interval] = distribution[key] %>
<% end %>

<%# Split data into positive and negative %>
<% positive_data, negative_data = sorted_distribution.partition { |k, v| k >= 0 }.map(&:to_h) %>

<div class="card card-chart p-6">
  <h2 class="text-lg font-semibold mb-4">每日損益風險分布</h2>
  <%= column_chart [
    {
      name: "獲利",
      data: positive_data,
      color: "#1E40AF"
    },
    {
      name: "虧損",
      data: negative_data,
      color: "#DC2626"
    }
  ],
      xtitle: "風險倍數 (R)",
      ytitle: "交易天數",
      stacked: true,
      library: {
        scales: {
          x: {
            title: { display: true, text: "風險倍數 (R)" }
          },
          y: {
            title: { display: true, text: "交易天數" },
            beginAtZero: true,
            ticks: { stepSize: 1 }
          }
        },
        plugins: {
          tooltip: {
            backgroundColor: '#1E293B',
            titleColor: '#E2E8F0',
            bodyColor: '#F1F5F9',
            borderColor: '#334155',
            borderWidth: 1,
            cornerRadius: 8,
            padding: 12,
            titleFont: { family: 'JetBrains Mono', size: 11 },
            bodyFont: { family: 'JetBrains Mono', size: 13, weight: 'bold' }
          }
        }
      } %>
</div>
