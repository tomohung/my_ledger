<div class="flex items-center gap-1 mt-3 md:mt-0">
  <%
    current_params = request.query_parameters.except("trade_type")
    tabs = [
      { label: "全部", value: nil },
      { label: "期貨", value: "futures" },
      { label: "選擇權", value: "options" }
    ]
  %>
  <% tabs.each do |tab| %>
    <% active = @trade_type == tab[:value] %>
    <% link_params = tab[:value] ? current_params.merge(trade_type: tab[:value]) : current_params %>
    <%= link_to tab[:label], url_for(link_params), class: "px-3 py-1 rounded-full text-sm font-medium transition-colors #{active ? 'bg-indigo-600 text-white' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'}" %>
  <% end %>
</div>
