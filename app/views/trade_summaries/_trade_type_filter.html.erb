<div class="flex items-center gap-1.5 mt-3 md:mt-0">
  <%
    safe_params = {
      date: params[:date],
      start_date: params[:start_date],
      end_date: params[:end_date]
    }.compact
    tabs = [
      { label: "全部", value: nil },
      { label: "期貨", value: "futures" },
      { label: "選擇權", value: "options" }
    ]
  %>
  <% tabs.each do |tab| %>
    <% active = @trade_type == tab[:value] %>
    <% link_params = tab[:value] ? safe_params.merge(trade_type: tab[:value]) : safe_params %>
    <%= link_to tab[:label], request.path + "?" + link_params.to_query, class: "filter-pill #{active ? 'filter-pill-active' : 'filter-pill-inactive'}" %>
  <% end %>
</div>
