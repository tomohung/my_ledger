<div class="card card-risk p-6">
  <h2 class="text-lg font-semibold mb-4">本週風險管理</h2>
  <div class="space-y-4">
    <div class="flex justify-between items-center">
      <% max_consecutive_losses = 6 %>
      <span class="text-gray-700">最大連續虧損次數: (< <%= max_consecutive_losses %>)</span>
      <span class="font-medium <%= @statistics[:max_consecutive_losses] >= max_consecutive_losses ? 'risk-danger' : '' %>">
        <%= @statistics[:max_consecutive_losses] %>
        <% if @statistics[:max_consecutive_losses] >= max_consecutive_losses %>
          (>= <%= max_consecutive_losses %>)
        <% end %>
      </span>
    </div>
    <div class="flex justify-between items-center">
      <% max_win_rate = 40 %>
      <span class="text-gray-700">勝率: (< <%= max_win_rate %> %)</span>
      <span class="font-medium <%= @statistics[:win_rate] <= max_win_rate ? 'risk-danger' : '' %>">
        <%= number_to_percentage(@statistics[:win_rate], precision: 1) %>
        <% if @statistics[:win_rate] <= max_win_rate %>
          (<= <%= max_win_rate %>%)
        <% end %>
      </span>
    </div>
    <div class="flex justify-between items-center">
      <% max_loss = @statistics[:max_loss] %>
      <% risk_amount = @month_report.ending_capital * current_user.risk_amount_percentage_per_trade / 100 %>
      <% risk_percentage = @month_report.ending_capital.zero? ? 0 : (max_loss.abs.to_f / risk_amount * 100).round %>
      <span class="text-gray-700">當週單筆最大虧損: (< <%= number_with_precision(risk_amount, precision: 0) %>)</span>
      <span class="font-medium <%=
        if risk_percentage >= 100
          'risk-danger'
        elsif risk_percentage >= 61.8
          'risk-caution'
        else
          ''
        end
      %>">
        <%= number_with_precision(max_loss, precision: 0) %>
        <% if @month_report.ending_capital > 0 %>
          (<%= risk_percentage %>% of risk)
        <% end %>
      </span>
    </div>
    <div class="flex justify-between">
      <% total_net_pnl = @trade_logs.sum { |log| log.net_pnl.to_f } %>
      <% risk_amount = @month_report.ending_capital * current_user.risk_amount_percentage_per_week / 100 %>
      <% quota = @month_report.ending_capital.zero? ? 0 : (total_net_pnl < 0 ? risk_amount + total_net_pnl : risk_amount) %>
      <span class="text-gray-700">本週淨損益: (< <%= number_with_precision(risk_amount, precision: 0) %>)</span>
      <span class="font-medium <%=
        if total_net_pnl > 0
          'text-profit'
        elsif quota <= 0
          'risk-danger'
        elsif quota <= risk_amount * 0.382
          'risk-caution'
        else
          ''
        end
      %>">
        <%= number_with_precision(total_net_pnl, precision: 0) %>
        <% if total_net_pnl < 0 && @month_report.ending_capital > 0 %>
          (剩餘配額: <%= number_with_precision(quota, precision: 0) %>)
        <% end %>
      </span>
    </div>
  </div>
</div>
