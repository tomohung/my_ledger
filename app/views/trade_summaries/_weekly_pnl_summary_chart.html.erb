<% weekday_pnl = @trade_logs.group_by { |log| log.trade_date.wday }.transform_values { |logs| logs.sum { |log| log.net_pnl.to_f } } %>
<% weekday_names = ['日', '一', '二', '三', '四', '五', '六'] %>

<%# Split data into positive and negative %>
<% positive_data = weekday_names.map.with_index { |name, i| [name, weekday_pnl[i]&.positive? ? weekday_pnl[i] : 0] } %>
<% negative_data = weekday_names.map.with_index { |name, i| [name, weekday_pnl[i]&.negative? ? weekday_pnl[i] : 0] } %>

  <%= column_chart [
    {
      name: "獲利",
      data: positive_data,
      color: "#1E40AF"
    },
    {
      name: "虧損",
      data: negative_data,
      color: "#DC2626"
    }
  ],
    xtitle: "星期",
    ytitle: "淨損益",
    library: {
      scales: {
        x: {
          title: { display: true, text: "星期" }
        },
        y: {
          title: { display: true, text: "淨損益" },
          beginAtZero: true
        }
      },
      plugins: {
        tooltip: {
          backgroundColor: '#1E293B',
          titleColor: '#E2E8F0',
          bodyColor: '#F1F5F9',
          borderColor: '#334155',
          borderWidth: 1,
          cornerRadius: 8,
          padding: 12,
          titleFont: { family: 'JetBrains Mono', size: 11 },
          bodyFont: { family: 'JetBrains Mono', size: 13, weight: 'bold' }
        }
      }
    },
    stacked: true
  %>
