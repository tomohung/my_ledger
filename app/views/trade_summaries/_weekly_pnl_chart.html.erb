<% active_logs = @trade_logs.select { |log| log.net_pnl.present? } %>
<% risk_amount = @month_report.initial_capital * current_user.risk_amount_percentage_per_trade / 100 %>

<% profit_large_risk = active_logs.select { |log| log.net_pnl >= 0 && log.net_pnl > risk_amount } %>
<% profit_small_risk = active_logs.select { |log| log.net_pnl >= 0 && log.net_pnl <= risk_amount } %>
<% loss_small_risk = active_logs.select { |log| log.net_pnl < 0 && log.net_pnl.abs <= risk_amount } %>
<% loss_large_risk = active_logs.select { |log| log.net_pnl < 0 && log.net_pnl.abs > risk_amount } %>

<%= scatter_chart [
  {
    name: "獲利 > 風險",
    data: profit_large_risk.map { |log| [log.trade_date.wday, log.net_pnl] },
    color: "#1E40AF"
  },
  {
    name: "獲利 ≤ 風險",
    data: profit_small_risk.map { |log| [log.trade_date.wday, log.net_pnl] },
    color: "#93C5FD"
  },
  {
    name: "虧損 ≤ 風險",
    data: loss_small_risk.map { |log| [log.trade_date.wday, log.net_pnl] },
    color: "#FCA5A5"
  },
  {
    name: "虧損 > 風險",
    data: loss_large_risk.map { |log| [log.trade_date.wday, log.net_pnl] },
    color: "#DC2626"
  }
],
    xtitle: "星期",
    ytitle: "損益",
    ymin: @trade_logs.map { |log| log.net_pnl.to_f }.min,
    ymax: @trade_logs.map { |log| log.net_pnl.to_f }.max,
    xmin: 0,
    xmax: 6,
    library: {
      plugins: {
        tooltip: {
          backgroundColor: '#1E293B',
          titleColor: '#E2E8F0',
          bodyColor: '#F1F5F9',
          borderColor: '#334155',
          borderWidth: 1,
          cornerRadius: 8,
          padding: 12,
          titleFont: { family: 'JetBrains Mono', size: 11 },
          bodyFont: { family: 'JetBrains Mono', size: 13, weight: 'bold' }
        }
      }
    }
    %>
