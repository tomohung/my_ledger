<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold">每月交易報告</h1>
  </div>

  <!-- Top Section -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
    <%= render 'capital_risk_management' %>

    <!-- Calendar Section -->
    <div class="bg-white rounded-lg shadow p-6">
      <div class="flex items-center justify-between mb-4">
        <%= link_to month_report_path(id: @selected_date - 1.month), class: "text-gray-600 hover:text-gray-900" do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
        <% end %>
        <h2 class="text-lg font-medium text-gray-900">
          <%= @selected_date.strftime("%Y年%m月") %>
        </h2>
        <%= link_to month_report_path(id: @selected_date + 1.month), class: "text-gray-600 hover:text-gray-900" do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        <% end %>
      </div>
      <div class="grid grid-cols-7 gap-1 text-center text-sm">
        <% %w[日 一 二 三 四 五 六].each do |day| %>
          <div class="py-2 text-gray-500"><%= day %></div>
        <% end %>
        <% @selected_date.beginning_of_month.beginning_of_week.upto(@selected_date.end_of_month.end_of_week) do |date| %>
          <div class="py-2 <%= date.month == @selected_date.month ? 'text-gray-900' : 'text-gray-400' %>">
            <%= date.day %>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Bottom Section -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <!-- Trading Performance -->
    <div class="bg-white rounded-lg shadow p-6">
      <h2 class="text-lg font-semibold mb-4">交易表現</h2>
      <div class="space-y-4">
        <div class="flex justify-between">
          <span class="text-gray-600">總交易次數</span>
          <span class="font-medium"><%= @month_report.total_trades %></span>
        </div>
        <div class="flex justify-between">
          <span class="text-gray-600">獲利交易</span>
          <span class="text-green-600 font-medium"><%= @month_report.winning_trades %></span>
        </div>
        <div class="flex justify-between">
          <span class="text-gray-600">虧損交易</span>
          <span class="text-red-600 font-medium"><%= @month_report.losing_trades %></span>
        </div>
        <div class="flex justify-between">
          <span class="text-gray-600">勝率</span>
          <span class="font-medium">
            <%= number_to_percentage(@month_report.win_rate, precision: 1) %>
          </span>
        </div>
      </div>
    </div>

    <!-- P&L Statistics -->
    <div class="bg-white rounded-lg shadow p-6">
      <h2 class="text-lg font-semibold mb-4">損益統計</h2>
      <div class="space-y-4">
        <div class="flex justify-between">
          <span class="text-gray-600">總損益</span>
          <span class="<%= @month_report.total_gross_pnl.to_i >= 0 ? 'text-green-600' : 'text-red-600' %> font-medium">
            <%= number_with_precision(@month_report.total_gross_pnl, precision: 0) %>
          </span>
        </div>
        <div class="flex justify-between">
          <span class="text-gray-600">手續費</span>
          <span class="font-medium"><%= number_with_precision(@month_report.total_commission, precision: 0) %></span>
        </div>
        <div class="flex justify-between">
          <span class="text-gray-600">交易稅</span>
          <span class="font-medium"><%= number_with_precision(@month_report.total_tax, precision: 0) %></span>
        </div>
        <div class="flex justify-between">
          <span class="text-gray-600">淨損益</span>
          <span class="<%= @month_report.total_net_pnl.to_i >= 0 ? 'text-green-600' : 'text-red-600' %> font-medium">
            <%= number_with_precision(@month_report.total_net_pnl, precision: 0) %>
          </span>
        </div>
      </div>
    </div>
  </div>
</div>
