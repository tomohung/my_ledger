<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "My Ledger" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Noto+Sans+TC:wght@400;500;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body data-controller="timezone">
    <nav class="fixed top-0 left-0 right-0 z-50" style="background-color: #141210; border-bottom: 1px solid #2A2520;">
      <div class="container mx-auto px-5">
        <div class="flex justify-between items-center h-14">
          <div class="flex items-center">
            <div class="logo-mark">L</div>
            <span class="logo-text">Ledger</span>
            <span class="logo-tagline ml-3 hidden md:inline">讓市場來找我</span>
          </div>
          <div class="flex items-center space-x-2">
            <div class="flex items-center space-x-1">
              <%= link_to "Daily", daily_trade_summaries_path, class: "#{current_page?(daily_trade_summaries_path) ? 'nav-link-active' : 'nav-link'}" %>
              <%= link_to "Weekly", weekly_trade_summaries_path, class: "#{current_page?(weekly_trade_summaries_path) ? 'nav-link-active' : 'nav-link'}" %>
              <%= link_to "Monthly", monthly_trade_summaries_path, class: "#{current_page?(monthly_trade_summaries_path) ? 'nav-link-active' : 'nav-link'}" %>
              <%= link_to "Overall", overall_trade_summaries_path, class: "#{current_page?(overall_trade_summaries_path) ? 'nav-link-active' : 'nav-link'}" %>
            </div>
            <div class="nav-separator"></div>
            <div class="flex items-center space-x-1">
              <%= link_to "Trade Logs", trade_logs_path, class: "#{current_page?(trade_logs_path) ? 'nav-link-active' : 'nav-link'}" %>
              <%= link_to "Trade Plots", new_trade_plot_path, class: "#{current_page?(new_trade_plot_path) ? 'nav-link-active' : 'nav-link'}" %>
            </div>
            <div class="nav-separator"></div>
            <div class="relative" data-controller="dropdown">
              <button class="nav-link flex items-center space-x-1" data-action="click->dropdown#toggle">
                <span><%= current_user.name %></span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div class="hidden absolute right-0 mt-2 w-48 rounded-lg py-1" style="background-color: #1E1B18; border: 1px solid #2A2520; box-shadow: var(--shadow-nav-dropdown);" data-dropdown-target="menu">
                <%= link_to "Settings", edit_user_path, class: "block px-4 py-2.5 text-sm text-gray-400 hover:text-gray-200 hover:bg-white/5 transition-colors" %>
                <%= button_to "Logout", session_path(Current.session), method: :delete, class: "block w-full text-left px-4 py-2.5 text-sm text-gray-400 hover:text-gray-200 hover:bg-white/5 transition-colors" %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </nav>

    <main class="container mx-auto mt-20 px-5 flex">
      <%= yield %>
    </main>
  </body>
</html>
