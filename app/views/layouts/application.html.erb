<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "My Ledger" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body data-controller="timezone">
    <nav class="fixed top-0 left-0 right-0 z-50" style="background-color: #0F1117; border-bottom: 1px solid #1E2028;">
      <div class="container mx-auto px-5">
        <div class="flex justify-between items-center h-16">
          <div class="flex items-center space-x-4">
            <span class="font-mono font-bold text-amber-400 mr-3">LOG</span>
            <span class="text-gray-400 italic">我是來交易的，不是來寫程式的</span>
            <span style="color: #2D3148">|</span>
            <span class="text-gray-400 italic">讓市場來找我</span>
          </div>
          <div class="flex items-center space-x-6">
            <div class="flex space-x-4">
              <%= link_to "Daily", daily_trade_summaries_path, class: "#{current_page?(daily_trade_summaries_path) ? 'nav-link-active' : 'text-gray-400 hover:text-gray-100 transition-colors'}" %>
              <%= link_to "Weekly", weekly_trade_summaries_path, class: "#{current_page?(weekly_trade_summaries_path) ? 'nav-link-active' : 'text-gray-400 hover:text-gray-100 transition-colors'}" %>
              <%= link_to "Monthly", monthly_trade_summaries_path, class: "#{current_page?(monthly_trade_summaries_path) ? 'nav-link-active' : 'text-gray-400 hover:text-gray-100 transition-colors'}" %>
              <%= link_to "Trade Logs", trade_logs_path, class: "#{current_page?(trade_logs_path) ? 'nav-link-active' : 'text-gray-400 hover:text-gray-100 transition-colors'}" %>
              <%= link_to "Trade Plots", new_trade_plot_path, class: "#{current_page?(new_trade_plot_path) ? 'nav-link-active' : 'text-gray-400 hover:text-gray-100 transition-colors'}" %>
            </div>
            <div class="relative" data-controller="dropdown">
              <button class="text-gray-300 hover:text-white flex items-center space-x-1" data-action="click->dropdown#toggle">
                <span><%= current_user.name %></span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div class="hidden absolute right-0 mt-2 w-48 rounded-md shadow-lg py-1" style="background-color: #1A1D27; border: 1px solid #2D3148;" data-dropdown-target="menu">
                <%= link_to "Settings", edit_user_path, class: "block px-4 py-2 text-sm text-gray-300 hover:bg-gray-700" %>
                <%= button_to "Logout", session_path(Current.session), method: :delete, class: "block w-full text-left px-4 py-2 text-sm text-gray-300 hover:bg-gray-700" %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </nav>

    <main class="container mx-auto mt-28 px-5 flex">
      <%= yield %>
    </main>
  </body>
</html>
