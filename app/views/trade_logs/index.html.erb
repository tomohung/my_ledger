<div class="container mx-auto px-4 py-8">
  <div class="flex flex-col md:flex-row items-center justify-between gap-4">
    <h1 class="text-3xl font-bold text-gray-800">交易紀錄列表</h1>
    <div class="flex flex-wrap gap-3 items-center justify-center">
      <%= link_to "新增交易紀錄", new_trade_log_path, class: "bg-green-600 hover:bg-green-700 text-white font-medium py-2 px-4 rounded-lg transition duration-200" %>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow overflow-hidden">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">#</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">交易日期</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">券商帳戶</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">商品名稱</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">合約月份</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">買口數</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">賣口數</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">成交價格</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">損益</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">手續費</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">交易稅</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">淨損益</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">幣別</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">委託書號</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">操作</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @trade_logs.each_with_index do |trade_log, index| %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= (@pagy.from + index) %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"><%= trade_log.trade_date %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"><%= trade_log.broker_account.name %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"><%= trade_log.product_name %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"><%= trade_log.contract_month %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"><%= trade_log.buy_quantity %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"><%= trade_log.sell_quantity %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"><%= number_with_precision(trade_log.price, precision: 2) %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"><%= number_with_precision(trade_log.gross_pnl, precision: 2) %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"><%= number_with_precision(trade_log.commission, precision: 2) %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"><%= number_with_precision(trade_log.tax, precision: 2) %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"><%= number_with_precision(trade_log.net_pnl, precision: 2) %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"><%= trade_log.currency %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"><%= trade_log.order_id %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= button_to "刪除", trade_log_path(trade_log),
                    method: :delete,
                    class: "text-red-600 hover:text-red-900 font-medium",
                    form: { data: { turbo_confirm: "確定要刪除這筆交易紀錄嗎？" } } %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="mt-6 flex justify-center">
    <%== pagy_nav(@pagy) %>
  </div>
</div>
