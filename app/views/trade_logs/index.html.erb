<div class="container mx-auto px-2 md:px-4 py-6 md:py-8">
  <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-3 animate-in">
    <h1>交易紀錄列表</h1>
    <div class="flex flex-wrap gap-3 items-center">
      <%= link_to "新增交易紀錄", new_trade_log_path, class: "btn btn-success" %>
    </div>
  </div>

  <div class="card card-data overflow-hidden mt-4 animate-in animate-in-1">
    <div class="overflow-x-auto">
      <table class="data-table min-w-full divide-y divide-gray-200">
        <thead>
          <tr>
            <th class="px-3 md:px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">#</th>
            <th class="px-3 md:px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">交易日期</th>
            <th class="px-3 md:px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">券商帳戶</th>
            <th class="px-3 md:px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">商品名稱</th>
            <th class="px-3 md:px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">合約月份</th>
            <th class="px-3 md:px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">買口數</th>
            <th class="px-3 md:px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">賣口數</th>
            <th class="px-3 md:px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">成交價格</th>
            <th class="px-3 md:px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">損益</th>
            <th class="px-3 md:px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">手續費</th>
            <th class="px-3 md:px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">交易稅</th>
            <th class="px-3 md:px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">淨損益</th>
            <th class="px-3 md:px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">幣別</th>
            <th class="px-3 md:px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">委託書號</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @trade_logs.each_with_index do |trade_log, index| %>
            <tr class="hover:bg-gray-50">
              <td class="px-3 md:px-6 py-3 md:py-4 whitespace-nowrap text-sm text-gray-500"><%= (@pagy.from + index) %></td>
              <td class="px-3 md:px-6 py-3 md:py-4 whitespace-nowrap text-sm text-gray-900"><%= trade_log.trade_date %></td>
              <td class="px-3 md:px-6 py-3 md:py-4 whitespace-nowrap text-sm text-gray-900"><%= trade_log.broker_account.name %></td>
              <td class="px-3 md:px-6 py-3 md:py-4 whitespace-nowrap text-sm text-gray-900"><%= trade_log.product_name %></td>
              <td class="px-3 md:px-6 py-3 md:py-4 whitespace-nowrap text-sm text-gray-900"><%= trade_log.contract_month %></td>
              <td class="px-3 md:px-6 py-3 md:py-4 whitespace-nowrap text-sm text-gray-900 font-mono"><%= trade_log.buy_quantity %></td>
              <td class="px-3 md:px-6 py-3 md:py-4 whitespace-nowrap text-sm text-gray-900 font-mono"><%= trade_log.sell_quantity %></td>
              <td class="px-3 md:px-6 py-3 md:py-4 whitespace-nowrap text-sm text-gray-900 font-mono"><%= number_with_precision(trade_log.price, precision: 2) %></td>
              <td class="px-3 md:px-6 py-3 md:py-4 whitespace-nowrap text-sm text-gray-900 font-mono"><%= number_with_precision(trade_log.gross_pnl, precision: 2) %></td>
              <td class="px-3 md:px-6 py-3 md:py-4 whitespace-nowrap text-sm text-gray-900 font-mono"><%= number_with_precision(trade_log.commission, precision: 2) %></td>
              <td class="px-3 md:px-6 py-3 md:py-4 whitespace-nowrap text-sm text-gray-900 font-mono"><%= number_with_precision(trade_log.tax, precision: 2) %></td>
              <td class="px-3 md:px-6 py-3 md:py-4 whitespace-nowrap text-sm font-mono <%= trade_log.net_pnl.to_f >= 0 ? 'pnl-positive' : 'pnl-negative' %>"><%= number_with_precision(trade_log.net_pnl, precision: 2) %></td>
              <td class="px-3 md:px-6 py-3 md:py-4 whitespace-nowrap text-sm text-gray-900"><%= trade_log.currency %></td>
              <td class="px-3 md:px-6 py-3 md:py-4 whitespace-nowrap text-sm text-gray-900"><%= trade_log.order_id %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="mt-4 md:mt-6 flex justify-center">
    <%== @pagy.series_nav %>
  </div>
</div>
