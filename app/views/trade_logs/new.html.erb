<%= link_to "返回交易紀錄列表", trade_logs_path %> |
<h1>貼上 CSV 內容匯入交易紀錄</h1>

<%= form_with url: trade_logs_path, method: :post, local: true do |form| %>
  <div>
    <%= form.label :broker_account_id, "選擇券商帳戶" %><br>
    <%= form.collection_select :broker_account_id, @broker_accounts, :id, :name, { prompt: "請選擇券商帳戶", selected: @broker_accounts&.first&.id }, { required: true } %>
  </div>

  <div>
    <%= form.label :csv_content, "請貼上 CSV 內容" %><br>
    <%= form.text_area :csv_content, rows: 20, cols: 100 %>
  </div>

  <div>
    <%= form.submit "匯入" %>
  </div>
<% end %>

<% if flash[:notice] %>
  <p style="color:green;"><%= flash[:notice] %></p>
<% end %>

<% if flash[:alert] %>
  <p style="color:red;"><%= flash[:alert] %></p>
<% end %>
