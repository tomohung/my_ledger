<%= link_to "返回交易紀錄列表", trade_logs_path, class: "text-amber-700 hover:text-amber-900 mb-4 inline-block transition-colors" %>

<div class="max-w-4xl mx-auto">
  <h1 class="mb-6">貼上 CSV 內容匯入交易紀錄</h1>

  <%= form_with url: trade_logs_path, method: :post, local: true, class: "space-y-6" do |form| %>
    <div class="space-y-2">
      <%= form.label :broker_account_id, "選擇券商帳戶", class: "block text-sm font-medium text-gray-700" %>
      <%= form.collection_select :broker_account_id, @broker_accounts, :id, :name,
          { prompt: "請選擇券商帳戶", selected: @broker_accounts&.first&.id },
          { required: true, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-amber-500 focus:ring-amber-500" } %>
    </div>

    <div class="space-y-2">
      <%= form.label :csv_content, "請貼上 CSV 內容", class: "block text-sm font-medium text-gray-700" %>
      <%= form.text_area :csv_content, rows: 20, cols: 100,
          class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-amber-500 focus:ring-amber-500 font-mono" %>
    </div>

    <div>
      <%= form.submit "匯入", class: "btn btn-primary" %>
    </div>
  <% end %>

  <% if flash[:notice] %>
    <p class="mt-4 text-green-600"><%= flash[:notice] %></p>
  <% end %>

  <% if flash[:alert] %>
    <p class="mt-4 text-red-600"><%= flash[:alert] %></p>
  <% end %>
</div>
