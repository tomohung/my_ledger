<div class="container mx-auto px-4 py-8">
  <h1 class="text-2xl font-bold mb-6">Generate Trade Plot Script</h1>

  <%= form_with url: trade_plots_path, method: :post, class: "space-y-6" do |f| %>
    <div>
      <%= f.label :csv_content, "Paste CSV Content", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= f.text_area :csv_content,
          rows: 10,
          class: "w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500",
          placeholder: "Paste your CSV content here..." %>
    </div>

    <div class="flex items-center">
      <%= f.check_box :merge_to_5min, class: "h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300 rounded" %>
      <%= f.label :merge_to_5min, "Merge trades to 5-minute intervals", class: "ml-2 block text-sm text-gray-900" %>
    </div>

    <%= f.submit "Generate Plot Script",
        class: "inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
  <% end %>

  <% if @plot_script.present? %>
    <div class="mt-8 w-full">
      <h2 class="text-xl font-semibold mb-4">Generated Plot Script</h2>
      <div class="bg-gray-50 p-4 rounded-lg border border-gray-300">
        <textarea
          id="plot-script-output"
          class="w-full h-[500px] bg-gray-50 text-sm text-gray-800 border-none focus:ring-0 focus:outline-none"
          readonly><%= @plot_script %></textarea>
      </div>
      <div class="mt-4">
        <button onclick="copyToClipboard()" class="py-2 px-4 bg-gray-600 text-white rounded hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-gray-500 focus:ring-offset-2">
          Copy to Clipboard
        </button>
      </div>
    </div>

    <script>
      function copyToClipboard() {
        const scriptTextarea = document.getElementById('plot-script-output');
        scriptTextarea.select();
        navigator.clipboard.writeText(scriptTextarea.value).then(() => {
          alert('Script copied to clipboard!');
        }).catch(err => {
          console.error('Could not copy text: ', err);
        });
      }
    </script>
  <% end %>
</div>
