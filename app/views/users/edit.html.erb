<div class="max-w-2xl mx-auto mt-10 p-6 card">
  <h1 class="text-2xl font-bold text-gray-800 mb-6">Account Settings</h1>

  <% if flash[:notice] %>
    <div class="mb-4 p-4 bg-green-50 text-green-600 rounded-md">
      <%= flash[:notice] %>
    </div>
  <% end %>

  <%= form_with model: @user, url: user_path, class: "space-y-6" do |form| %>
    <div class="space-y-4">
      <h2 class="text-lg font-semibold text-gray-700">Risk Settings</h2>

      <div>
        <%= form.label :risk_amount_percentage_per_trade, "Risk Amount per Trade (%)", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.number_field :risk_amount_percentage_per_trade,
            step: 0.1,
            class: "w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
      </div>

      <div>
        <%= form.label :risk_amount_percentage_per_day, "Risk Amount per Day (%)", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.number_field :risk_amount_percentage_per_day,
            step: 0.1,
            class: "w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
      </div>

      <div>
        <%= form.label :risk_amount_percentage_per_week, "Risk Amount per Week (%)", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.number_field :risk_amount_percentage_per_week,
            step: 0.1,
            class: "w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
      </div>

      <div>
        <%= form.label :risk_amount_percentage_per_month, "Risk Amount per Month (%)", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.number_field :risk_amount_percentage_per_month,
            step: 0.1,
            class: "w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
      </div>
    </div>

    <div class="space-y-4">
      <h2 class="text-lg font-semibold text-gray-700">Initial Capital</h2>

      <div>
        <%= form.label :initial_capital, "Initial Capital", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.number_field :initial_capital,
            step: 1,
            class: "w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
      </div>
    </div>

    <div>
      <%= form.submit "Save Settings",
          class: "w-full bg-blue-800 text-white py-2 px-4 rounded-md hover:bg-blue-900 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition-colors" %>
    </div>
  <% end %>
</div>
